# Copy this file to ".env" and fill in the values. Never commit the real .env.

# Free API key from https://console.groq.com/keys  (required)
GROQ_API_KEY=

# Any long random string. Needed to call /api/admin/* (refresh, logs).
# Leave empty to disable the admin endpoints.
ADMIN_TOKEN=

# ---- Optional overrides (defaults are in app/config.py) ----
# GROQ_ANSWER_MODEL=openai/gpt-oss-120b
# GROQ_REWRITE_MODEL=openai/gpt-oss-20b
# GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
# GROQ_REASONING_EFFORT=low
# MIN_SIMILARITY=0.55
# AUTO_REFRESH_HOURS=24
